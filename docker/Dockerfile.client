# Client, needs X11 + OpenGL for macroquad, multi-stage with cargo-chef

FROM rust:1.97.1-slim-bookworm AS chef
RUN cargo install cargo-chef
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
#macroquad build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libx11-dev \
    libxi-dev \
    libgl1-mesa-dev \
    libasound2-dev \
    libxkbcommon-dev \
    libxkbcommon-x11-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=planner /app/recipe.json recipe.json
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
RUN cargo build --release -p client && cp target/release/client /usr/local/bin/maze-client

# debian-slim runtime, distroless won't work here (needs OpenGL/X11)
FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y \
    libx11-6 \
    libxi6 \
    libgl1-mesa-glx \
    libasound2 \
    libxkbcommon0 \
    libxkbcommon-x11-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /usr/local/bin/maze-client /usr/local/bin/maze-client
# run as non-root
RUN useradd -m appuser
USER appuser
ENTRYPOINT ["/usr/local/bin/maze-client"]
